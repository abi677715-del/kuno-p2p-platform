generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  USDT
  ETB
}

enum Network {
  TRC20
  ERC20
  BEP20
  POLYGON
  ARBITRUM
  OPTIMISM
  SOLANA
  TON
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  LOCK
  RELEASE
  REFUND
  FEE
  REFERRAL
}

enum TxStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
}

enum AdSide {
  BUY
  SELL
}

enum AdStatus {
  ACTIVE
  PAUSED
}

enum AdPricingMode {
  FIXED
  FLOATING
}

enum RelationType {
  BLOCK
  FAVORITE
}

enum TradeStatus {
  PENDING
  PAID
  ESCROW_LOCKED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum EscrowStatus {
  LOCKED
  RELEASED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum MerchantApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  RESOLVED
}
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}
model User {
  id                     String     @id @default(uuid())
  bidNumber              Int        @unique @default(autoincrement())
  fullName               String?
  avatar                 String?    @db.Text
  email                  String     @unique
  phone                  String?    @unique
  passwordHash           String
  role                   Role       @default(USER)
  status                 UserStatus @default(ACTIVE)
  twoFaEnabled           Boolean    @default(false)
  twoFaSecret            String?
  isMerchant             Boolean    @default(false)
  emailVerified          Boolean    @default(false)
  emailVerificationToken String?    @unique
  passwordResetToken     String?    @unique
  passwordResetExpires   DateTime?
  createdAt              DateTime   @default(now())
  lastSeenAt             DateTime   @default(now())
  defaultPaymentMethods  String[]   @default([])
  referredById           String?
  termsAcceptedAt        DateTime?

  kycRecord        KycRecord?
  wallets          Wallet[]
  depositAddresses DepositAddress[]
  ads              Ad[]
  buyTrades        Trade[]          @relation("buyer")
  sellTrades       Trade[]          @relation("seller")
  tradeMessages    TradeMessage[]
  disputesRaised   Dispute[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  referredBy       User?            @relation("referrals", fields: [referredById], references: [id])
  referrals        User[]           @relation("referrals")
  relationsMade    UserRelation[]   @relation("relationOwner")
  relationsOfMe    UserRelation[]   @relation("relationTarget")
  merchantApplications MerchantApplication[]
  transactionAppeals   TransactionAppeal[]
  supportMessages      SupportMessage[]
  ratingsGiven         TradeRating[]          @relation("rater")
  ratingsReceived      TradeRating[]          @relation("ratedUser")
  pushSubscriptions    PushSubscription[]
  @@map("users")
}

model MerchantApplication {
  id              String                    @id @default(uuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id])
  reason          String                    @db.Text
  status          MerchantApplicationStatus @default(PENDING)
  rejectionReason String?                   @db.Text
  createdAt       DateTime                  @default(now())
  reviewedAt      DateTime?

  @@map("merchant_applications")
}

model UserRelation {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation("relationOwner", fields: [userId], references: [id])
  targetUserId String
  targetUser   User         @relation("relationTarget", fields: [targetUserId], references: [id])
  type         RelationType
  createdAt    DateTime     @default(now())

  @@unique([userId, targetUserId])
  @@map("user_relations")
}

model KycRecord {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id])
  idType       String
  idNumber     String
  documentUrl  String
  selfieUrl    String
  status       KycStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@map("kyc_records")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  currency      Currency
  balance       Decimal  @default(0) @db.Decimal(20, 8)
  lockedBalance Decimal  @default(0) @db.Decimal(20, 8)

  transactions WalletTransaction[]

  @@unique([userId, currency])
  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        TxType
  amount      Decimal  @db.Decimal(20, 8)
  referenceId String?
  network     Network?
  status      TxStatus @default(PENDING)
  txHash      String?
  fromAddress String?
  code        String?
  createdAt   DateTime @default(now())
  firstApprovedBy String?
  firstApprovedAt DateTime?

  appeals TransactionAppeal[]

  @@map("wallet_transactions")
}

model DepositAddress {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  network   Network
  address   String   @unique
  createdAt DateTime @default(now())

  @@map("deposit_addresses")
}

model Ad {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  side           AdSide
  priceEtb       Decimal       @db.Decimal(20, 4)
  minLimitEtb    Decimal       @db.Decimal(20, 4)
  maxLimitEtb    Decimal       @db.Decimal(20, 4)
  paymentMethods String[]
  description    String?       @db.Text
  status         AdStatus      @default(ACTIVE)
  pricingMode    AdPricingMode @default(FIXED)
  marginPercent  Decimal?      @db.Decimal(6, 2)
  createdAt      DateTime      @default(now())

  trades Trade[]

  @@map("ads")
}

model Trade {
  id         String      @id @default(uuid())
  code       String?     @unique
  adId       String
  ad         Ad          @relation(fields: [adId], references: [id])
  buyerId    String
  buyer      User        @relation("buyer", fields: [buyerId], references: [id])
  sellerId   String
  seller     User        @relation("seller", fields: [sellerId], references: [id])
  amountUsdt Decimal     @db.Decimal(20, 8)
  amountEtb  Decimal     @db.Decimal(20, 4)
  status     TradeStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  paidAt     DateTime?
  completedAt      DateTime?
  buyerLastReadAt  DateTime?
  sellerLastReadAt DateTime?
  timeoutWarnedAt  DateTime?

  escrow   Escrow?
  messages TradeMessage[]
  dispute  Dispute?
  ratings  TradeRating[]

  @@map("trades")
}

model TradeRating {
  id          String   @id @default(uuid())
  tradeId     String
  trade       Trade    @relation(fields: [tradeId], references: [id])
  raterId     String
  rater       User     @relation("rater", fields: [raterId], references: [id])
  ratedUserId String
  ratedUser   User     @relation("ratedUser", fields: [ratedUserId], references: [id])
  stars       Int
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([tradeId, raterId])
  @@map("trade_ratings")
}

model Escrow {
  id         String       @id @default(uuid())
  tradeId    String       @unique
  trade      Trade        @relation(fields: [tradeId], references: [id])
  amount     Decimal      @db.Decimal(20, 8)
  status     EscrowStatus @default(LOCKED)
  releasedAt DateTime?

  @@map("escrow_ledger")
}

model TradeMessage {
  id            String   @id @default(uuid())
  tradeId       String
  trade         Trade    @relation(fields: [tradeId], references: [id])
  senderId      String
  sender        User     @relation(fields: [senderId], references: [id])
  message       String
  attachmentUrl String?
  createdAt     DateTime @default(now())

  @@map("trade_messages")
}

model Dispute {
  id         String        @id @default(uuid())
  tradeId    String        @unique
  trade      Trade         @relation(fields: [tradeId], references: [id])
  raisedById String
  raisedBy   User          @relation(fields: [raisedById], references: [id])
  reason     String
  evidenceUrl String?      @db.Text
  status     DisputeStatus @default(OPEN)
  resolvedBy String?
  resolution String?
  createdAt  DateTime      @default(now())

  @@map("disputes")
}

enum AppealStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Lets a user contest a specific wallet transaction (a rejected deposit/withdrawal, a fee they disagree with, etc.) instead of only being able to raise a dispute on a trade.
model TransactionAppeal {
  id            String            @id @default(uuid())
  transactionId String
  transaction   WalletTransaction @relation(fields: [transactionId], references: [id])
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  reason        String            @db.Text
  status        AppealStatus      @default(OPEN)
  resolution    String?           @db.Text
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime          @default(now())

  @@map("transaction_appeals")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("notifications")
}

model SupportTicket {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())

  messages SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id            String        @id @default(uuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User          @relation(fields: [senderId], references: [id])
  message       String
  attachmentUrl String?
  createdAt     DateTime      @default(now())

  @@map("support_messages")
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  targetId  String?
  createdAt DateTime @default(now())

  @@map("admin_audit_logs")
}
